#property copyright "AdaptiveFX"
#property version   "1.00"
#property strict

// Include ZeroMQ library (must be installed separately)
// #include <Zmq/Zmq.mqh>

//--- Input parameters
input string   ZMQ_ADDRESS      = "tcp://localhost:5555"; // Python publisher address
input string   ZMQ_TOPIC        = "SIGNAL";               // ZeroMQ topic to subscribe to
input double   DEFAULT_LOT_SIZE = 0.01;                   // Fallback lot size if risk calc fails
input int      MAGIC_NUMBER     = 20260406;               // EA magic number for order tracking
input int      SLIPPAGE         = 10;                     // Max allowed slippage (points)
input bool     ENABLE_TRADING   = false;                  // Safety switch — set to true to trade

//--- Global variables
// Context  g_context;
// Socket   g_subscriber;
bool     g_zmq_connected = false;
datetime g_last_signal_time = 0;

